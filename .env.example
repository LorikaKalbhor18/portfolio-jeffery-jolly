# Public var — used by the browser to detect mock mode.
# VITE_ variables are visible in the browser bundle. Never put secrets here.
VITE_FORM_ENDPOINT=

# Server-only var — read by the /api/contact Edge Function to proxy to Formspree.
# Set this in Vercel project settings (Environment Variables) for production.
# Not exposed to the browser.
FORM_ENDPOINT=

# CAPTCHA — optional. Both vars must be set to enable the widget.
# Supported values for VITE_CAPTCHA_PROVIDER: hcaptcha | recaptcha
# Add the provider's script tag to index.html and extend the CSP in vercel.json
# before enabling in production.
VITE_CAPTCHA_PROVIDER=
VITE_CAPTCHA_SITE_KEY=
